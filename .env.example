# Hackpot Telegram bot — configuration template
# Copy to .env and replace every REPLACEME value. The real .env is git-ignored.
# Full semantics: README.md "Configuration".

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:REPLACEME

# Authorized admins: comma-separated NUMERIC Telegram user IDs.
# Numeric IDs only (can't be renamed/squatted); find yours via @userinfobot.
AUTHORIZED_USERS=11111111,22222222

# --- Target repository ---
TARGET_REPO=HackPot-HQ/Hackpot
TARGET_BRANCH=main

# --- Hackpot leaf categories ---
# JSON map: leaf path -> decision criteria sent to the model as the `choice`
# options. Keys must match NN_Domain/Sub_Category exactly (31 live leaves).
# Refine the descriptions for better placement quality.
CATEGORIES_JSON={"01_Recon_and_OSINT/OSINT":"Tracking, gathering intelligence and investigating targets using public open-source information","01_Recon_and_OSINT/Port_Scanning":"Port scanners and service discovery tools like nmap, masscan, rustscan","01_Recon_and_OSINT/Subdomain_Enumeration":"Subdomain enumeration and DNS discovery tools like amass, subfinder, assetfinder","02_Web_Application/Directory_Bruteforcing":"Content discovery and directory brute-forcing like ffuf, gobuster, dirsearch","02_Web_Application/Proxies_and_Scanners":"Intercepting proxies and web vulnerability scanners like Burp Suite, ZAP, nuclei","02_Web_Application/Vulnerability_Specific":"Tools targeting specific web vulnerabilities like SQLi, XSS, SSRF, XXE","03_Network_and_Infrastructure/Active_Directory":"Active Directory enumeration, attack and defence tooling like BloodHound, Impacket","03_Network_and_Infrastructure/Packet_Analysis":"Packet capture, traffic analysis and network forensics like Wireshark, tcpdump","03_Network_and_Infrastructure/Wireless_and_Radio":"WiFi, Bluetooth, RFID and radio hacking tools like Aircrack-ng, Ubertooth","04_Exploitation_and_PrivEsc/Exploitation_Frameworks":"Exploitation frameworks and payload tooling like Metasploit, Sliver, Cobalt Strike","04_Exploitation_and_PrivEsc/Linux_PrivEsc":"Linux privilege escalation and local enumeration tools like linpeas","04_Exploitation_and_PrivEsc/Windows_PrivEsc":"Windows privilege escalation and local enumeration tools like WinPEAS","05_Reverse_Engineering/Disassemblers":"Disassemblers, decompilers and binary analysis tools like Ghidra, IDA, radare2","05_Reverse_Engineering/Malware_Analysis":"Malware analysis, sandboxing and reverse-engineering of malicious code","06_Cryptography_and_Cracking/Password_Cracking":"Hash cracking and password attacks like Hashcat, John the Ripper","06_Cryptography_and_Cracking/Steganography":"Steganography detection, encoding and analysis tools","07_Hardware_IoT_and_ICS/Automotive_and_CAN_Bus":"Car hacking, CAN bus and automotive security tooling","07_Hardware_IoT_and_ICS/Hardware_Hacking":"Hardware pentest tooling: UART, JTAG, SPI, bus pirate, flipper","07_Hardware_IoT_and_ICS/ICS_and_SCADA":"Industrial control systems, SCADA and OT security resources","07_Hardware_IoT_and_ICS/IoT_and_Smart_Devices":"IoT firmware analysis and smart device security tools","08_Cloud_and_Containers/Cloud_Providers_AWS_Azure_GCP":"Cloud security assessment tools for AWS, Azure, GCP","08_Cloud_and_Containers/Docker_and_Kubernetes":"Container and Kubernetes security tooling and resources","09_Wordlists_and_Payloads/Dictionaries":"Wordlists and brute-force dictionaries like SecLists, rockyou","09_Wordlists_and_Payloads/Reverse_Shells":"Reverse shell payloads, generators and connectivity upgrade tools","10_Learning_and_Resources/Blogs_and_Podcasts":"Security blogs, podcasts and written/video learning resources","10_Learning_and_Resources/Cheat_Sheets":"Cheat sheets, command references and quick guides","10_Learning_and_Resources/Practice_Labs":"Hands-on practice platforms and labs like HTB, THM, PortSwigger","11_AI_and_Machine_Learning/AI_Assisted_Offensive_Tools":"AI-assisted offensive security tooling and agents","11_AI_and_Machine_Learning/AI_Coding_Tools":"AI coding assistants used for security work","11_AI_and_Machine_Learning/Adversarial_ML_and_Model_Security":"Adversarial machine learning and ML model security research","11_AI_and_Machine_Learning/LLM_Security_and_Prompt_Injection":"LLM security, prompt injection and red-teaming of language models"}

# --- Qwen decision model (System One) ---
# URL is workspace-dedicated; get the host + key from your Qwen Model Studio
# workspace (API Keys page). Key is sent as: Authorization: Bearer <key>
QWEN_API_URL=https://REPLACE-WORKSPACE-ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/systemone
QWEN_API_KEY=sk-REPLACEME
QWEN_MODEL=decision-model-preview

# --- Classification UI ---
# Minimum option probability to appear as a candidate button, and max buttons.
CONFIDENCE_THRESHOLD=0.15
MAX_CANDIDATES_SHOWN=3

# --- Storage ---
# Inside the container this path lives on the hackpot-data named volume.
DB_PATH=data/hackpot.sqlite3
# Generate a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# --- Limits ---
RATE_LIMIT_PER_MIN=10

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL (default INFO).
# Set DEBUG to debug errors with state transitions and request summaries;
# credentials are redacted at the log handler on every level.
LOG_LEVEL=INFO
